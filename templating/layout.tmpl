<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ .Meta.PageTitle }}</title>
  <link rel="stylesheet" href="morphic.css">
</head>
<body class="{{ .Meta.ThemeClass }}">

  <header>
    <div class="container">
      <a href="mono-culture.html" class="logo">{{ .Nav.LogoText }}</a>
      <button class="hamburger" id="hamburger-btn">{{ .Nav.HamBtnIcon }}</button>
      <nav id="nav-menu">
        <a href="#home">{{ .Nav.HomeLabel }}</a>
        <a href="#menu">{{ .Nav.MenuLabel }}</a>
        <a href="#about">{{ .Nav.AboutLabel }}</a>
        <a href="#contact">{{ .Nav.ContactLabel }}</a>

        {{ block "cart-trigger" . }}
        <button class="btn cart-trigger-btn" id="open-cart-btn">
          {{ $.Cart.TriggerLabel }} <span class="cart-count" id="cart-indicator">{{ $.Cart.TotalItems }}</span>
        </button>
        {{ end }}

        <div class="theme-switch-wrapper">
          <span class="theme-label label-cyber">CYBER</span>
          <label class="theme-switch" for="checkbox">
            <input type="checkbox" id="checkbox" {{ if eq .Meta.ThemeClass "theme-corporate" }}checked{{ end }} />
            <div class="slider-toggle round"></div>
          </label>
          <span class="theme-label label-corp">CORP</span>
        </div>
      </nav>
    </div>
  </header>

  <section id="home">
    <div>
      <h1>{{ .Hero.Title }}</h1>
      <p>{{ .Hero.Subtitle }}</p>
    </div>
  </section>

  <section id="about">
    <div class="container">
      <h2 class="section-title">{{ .About.Title }}</h2>
      <div class="about-content">
        <!--{{ if .About.AlertText }}-->
        <!--<div class="glitch-alert">{{ .About.AlertText }}</div>-->
        <!--{{ end }}-->
        <p>{{ .About.Content }}</p>
      </div>
    </div>
  </section>

  <section id="menu">
    <div class="container">
      <h2 class="section-title">{{ .Menu.Title }}</h2>
      <div class="menu-grid">
        {{ range .Menu.Items }}
        <div class="menu-card">
          <img class="menu-img" src="{{ .ImgSrc }}" alt="{{ .Name }}">
          <div class="menu-info">
            <div class="menu-title-row">
              <h3>{{ .Name }}</h3>
              <span class="menu-price">{{ .Price }} {{ $.Meta.CurrencyLabel }}</span>
            </div>
            <p class="menu-desc">{{ .Desc }}</p>

            <button class="btn add-to-cart-btn"
                    data-on-click="$$post('/api/cart/add?id={{ .ID }}')">
              {{ $.Menu.ActionBtnText }}
            </button>
          </div>
        </div>
        {{ end }}
      </div>
    </div>
  </section>

  <section id="gallery">
    <div class="container">
      <h2 class="section-title">{{ .Gallery.Title }}</h2>
      <div class="slider-container">
        <div class="slider" id="image-slider">
          {{ range .Gallery.Images }}
          <img class="slide" src="{{ . }}" alt="Gallery Image Fragment">
          {{ end }}
        </div>
        <button class="slider-btn prev" id="slider-prev-btn">◀</button>
        <button class="slider-btn next" id="slider-next-btn">▶</button>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="container">
      <h2 class="section-title">{{ .Contact.Title }}</h2>
      <div class="contact-wrapper">
        <form class="contact-form" onsubmit="event.preventDefault();">
          <div class="form-group">
            <label>{{ .Contact.NameLabel }}</label>
            <input type="text" name="name" required>
          </div>
          <div class="form-group">
            <label>{{ .Contact.EmailLabel }}</label>
            <input type="email" name="email" required>
          </div>
          <div class="form-group">
            <label>{{ .Contact.MessageLabel }}</label>
            <textarea rows="5" name="message" required></textarea>
          </div>
          <button type="submit" class="btn" data-on-click="$$post('/api/telemetry')">
            {{ .Contact.SubmitBtnText }}
          </button>
        </form>
        <div class="map-container">
          <iframe src="{{ .Contact.MapUrl }}" allowfullscreen="" loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </section>

  {{ block "cart-sidebar" . }}
  <div class="cart-sidebar" id="cart-sidebar">
    <div class="cart-header">
      <h3>{{ .Cart.Title }}</h3>
      <button class="cart-close" id="close-cart-btn">🎚️</button>
    </div>

    <div class="cart-items" id="cart-items-container">
      {{ range .Cart.Items }}
      <div class="cart-item">
        <div class="cart-item-info">
          <h4>{{ .Name }}</h4>
          <span>{{ .Price }} {{ $.Meta.CurrencyLabel }} x {{ .Quantity }}</span>
        </div>
        <button class="remove-item-btn"
                data-on-click="$$post('/api/cart/remove?id={{ .ID }}')">
          {{ $.Cart.RemoveBtnText }}
        </button>
      </div>
      {{ else }}
      <p style="text-align:center; color:#555; font-size:0.8rem; margin-top:20px;">{{ .Cart.EmptyText }}</p>
      {{ end }}
    </div>

    <div class="cart-footer">
      <div class="cart-total-row">
        <span>{{ .Cart.TotalLabel }}</span>
        <span id="cart-total-price">{{ .Cart.TotalPrice }} {{ .Meta.CurrencyLabel }}</span>
      </div>
      <div class="cart-actions">
        <button class="btn btn-clear" data-on-click="$$post('/api/cart/clear')">
          {{ .Cart.ClearBtnText }}
        </button>
      </div>
    </div>
  </div>
  {{ end }}

  <footer>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <h3>{{ .Footer.CorpName }}</h3>
          <p>{{ .Footer.Tagline }}</p>
        </div>
        <div class="footer-col">
          <h3>{{ .Footer.HoursTitle }}</h3>
          {{ range .Footer.HoursLines }}
          <p>{{ . }}</p>
          {{ end }}
        </div>
        <div class="footer-col">
          <h3>{{ .Footer.SocialsTitle }}</h3>
          <div class="social-links">
            {{ range $name, $url := .Footer.SocialLinks }}
            <a href="{{ $url }}">{{ $name }}</a>
            {{ end }}
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>{{ .Footer.CopyrightLine }}</p>
      </div>
    </div>
  </footer>

  <script src="cyber-critique.js"></script>
</body>
</html>